# Copy to .env and adjust. Never commit .env.
PROJECT_NAME=schnur23

# Caddy site address. ":80" serves plain HTTP locally; set the bare domain on
# the server and Caddy issues the certificate automatically. No scheme here —
# with "https://" Caddy never starts the ACME challenge.
SITE_ADDRESS=:80

# Host that only redirects to SITE_ADDRESS. Set it once the www DNS record
# exists; leaving it unset keeps Caddy from requesting a cert it cannot get.
# WWW_ADDRESS=www.schnur23.de

# Public origin of the site. Must match what the browser sees, otherwise
# adapter-node rejects form actions.
ORIGIN=http://localhost

# Host port for the dev stack (compose.dev.yml). Not Vite's default 5173,
# because the interactive-movie-berlin-students container already holds it.
DEV_PORT=5174
