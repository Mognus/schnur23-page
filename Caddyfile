# Defaults to plain HTTP on :80 for a local prod smoke test. Set SITE_ADDRESS
# to the domain on the server and Caddy provisions the certificate itself.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# No Cache-Control here: adapter-node already marks /_app/immutable as
	# immutable itself, and setting it again just duplicates the header.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy web:3000
}

# www is a redirect, not a second copy of the site: serving both would break
# ORIGIN, which adapter-node checks against a single canonical host.
# WWW_ADDRESS is unset locally, so this block collapses to a dummy host.
{$WWW_ADDRESS:www.localhost} {
	redir https://{$SITE_ADDRESS}{uri} permanent
}
